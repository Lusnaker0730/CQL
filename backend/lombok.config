# Pin Lombok to emit Jackson 3 (tools.jackson) annotations when @Jacksonized is
# present. Without this, Lombok defaults to Jackson 2 (com.fasterxml.jackson)
# annotations and emits a warning — which produces the wrong @JsonPOJOBuilder /
# @JsonDeserialize import paths under Spring Boot 4 (#PR-533) where Jackson 3 is
# the runtime ObjectMapper. See https://projectlombok.org/features/experimental/Jacksonized
lombok.jacksonized.jacksonVersion = 3
