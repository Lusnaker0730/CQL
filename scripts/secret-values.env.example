# Secret values template for CQL Platform
# Copy this file to secret-values.env and fill in real values
# NEVER commit secret-values.env to version control
#
# Usage: ./scripts/seal-secrets.sh

# Database credentials
DB_USERNAME=
DB_PASSWORD=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Application secrets
JWT_SECRET=
ENCRYPTION_KEY=

# Grafana admin password
GF_SECURITY_ADMIN_PASSWORD=

# VSAC (Value Set Authority Center) API key
VSAC_API_KEY=

# Okta OIDC configuration
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_ISSUER=
