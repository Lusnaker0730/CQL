# CQL Platform Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control

# PostgreSQL
POSTGRES_DB=cqlplatform
POSTGRES_USER=cqlplatform
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# Backend
DB_URL=jdbc:postgresql://postgres:5432/cqlplatform
DB_USERNAME=cqlplatform
DB_PASSWORD=CHANGE_ME_postgres_password
JWT_SECRET=CHANGE_ME_must_be_at_least_256_bits_long_for_HS256
ENCRYPTION_KEY=CHANGE_ME_must_be_exactly_32bytes

# FHIR
FHIR_SERVER_URL=http://launch.smarthealthit.org/v/r4/fhir
FHIR_TERMINOLOGY_URL=http://tx.fhir.org/r4

# CORS — comma-separated origins for external access
# Example: https://www.twcql.com,http://192.168.1.100:8888
CORS_ALLOWED_ORIGINS=

# SMART on FHIR — external-facing URLs for .well-known/smart-configuration
# Must match the public URL users access the platform from
SMART_ISSUER=https://your-domain.com
SMART_AUTH_ENDPOINT=https://your-domain.com/api/auth/login
SMART_TOKEN_ENDPOINT=https://your-domain.com/api/auth/login

# App base URL — used for password reset links, email notifications, etc.
APP_BASE_URL=https://your-domain.com

# AI Fix Suggestion
# Provider: none (default), ollama (local GPU), cloud (OpenAI-compatible)
AI_PROVIDER=none

# Ollama — only needed when AI_PROVIDER=ollama
# Start with: docker compose --profile ollama up -d
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Cloud AI — only needed when AI_PROVIDER=cloud
# Supports OpenAI, Azure OpenAI, DeepSeek, Groq, etc.
# AI_CLOUD_API_URL=https://api.openai.com/v1/chat/completions
# AI_CLOUD_MODEL=gpt-4o-mini
# AI_CLOUD_API_KEY=sk-...

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# Prometheus scrape auth (PAT-113)
# /actuator/prometheus is protected by HTTP Basic. These credentials must
# match on both sides: the Spring backend (METRICS_SCRAPE_USER/PASSWORD)
# and the Prometheus container (which uses METRICS_SCRAPE_PASSWORD to
# populate basic_auth.password_file at startup).
# Generate with: openssl rand -base64 24
METRICS_SCRAPE_USER=prometheus
METRICS_SCRAPE_PASSWORD=CHANGE_ME_scrape_password_24_chars_or_more
